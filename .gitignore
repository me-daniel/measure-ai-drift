# Files to ignore when using git

# Protect API keys from getting public:
.env 

# Ignore markdown files in root directory only (keep docs/*.md, etc.)
/*.md

# Promptfoo (kept fully local)
promptfoo/

# Editor settings
.vscode/

# Stray logs in root
/*.log

# Packaging metadata
*.egg-info/

# ignore temporary data files
.DS_Store
src/evaluation/__pycache__/*.cpython-310.pyc
# Python bytecode
__pycache__/
*.pyc

# Generated test data
data/synthetic/dialogues/*.json
data/synthetic/frozen_histories/
data/synthetic/results/*.json
experiments/

# Claude Code local settings
.claude/
src/__pycache__/
src/**/__pycache__/

# LaTeX build artifacts
thesis/build/
thesis/*.aux
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.lof
thesis/*.lot
thesis/*.synctex.gz
thesis/*.fls
thesis/*.fdb_latexmk
thesis/*.bbl
thesis/*.blg
thesis/*.bcf
thesis/*.run.xml
thesis/*.acn
thesis/*.acr
thesis/*.alg
thesis/*.glg
thesis/*.glo
thesis/*.gls
thesis/*.ist
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/arxiv_submission.tar.gz

# Ignore screenshots
screenshots/
# Ignore derived analysis caches
stats/data/cache/
